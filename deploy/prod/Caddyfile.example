# OpenGunstore vhost for a host-level Caddy.
# The POS stack does not run its own proxy (see the compose.noproxy override): its
# frontend is published on 127.0.0.1:8080 and fronted by this block. If you change
# HTTP_PUBLISH_PORT in deploy/prod/.env, change the reverse_proxy line below to match.
#
# Replace pos.example.com with the site's public host name (the Frappe site name)
# before appending this block to /etc/caddy/Caddyfile (docs/self-hosting.md#reverse-proxy
# has a one-line sed for it), then:
#   sudo caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   sudo systemctl reload caddy
# Caddy auto-issues the Let's Encrypt certificate for that host.
#
# Editing a shared Caddyfile is a change to shared infrastructure: do it by hand
# on the server. See docs/self-hosting.md#reverse-proxy.

pos.example.com {
    # Bare root (GET /) has no Frappe website home, so send it to the login page.
    # Scope the matcher to GET — POST / must pass through: Frappe's legacy
    # form-post endpoint lives at / (report Excel/CSV export uses open_url_post
    # → POST /), and redirecting that to /login silently breaks every report's
    # export (download does nothing).
    @root {
        path /
        method GET
    }
    redir @root /login

    reverse_proxy 127.0.0.1:8080 {
        header_up Host {host}
    }
}

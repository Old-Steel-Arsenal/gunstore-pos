# Facts about YOUR store, read by scripts/store_setup.sh (ffl_core.setup.store_setup).
# Copy to deploy/prod/store.env, fill in, run:  ./scripts/store_setup.sh deploy/prod/store.env
# store.env is gitignored. Keep it out of git: it can carry an SMTP password.
#
# Only the keys listed in this file are read; any other name in your store.env is reported and skipped.
# One KEY=value per line. No quotes needed (one matching pair is stripped), no $variables,
# no inline comments. The values below are made up; replace every one of them.
# REQUIRED keys must be filled in or the run refuses before it writes anything.
# A blank OPTIONAL key means "leave that out": it never falls back to anyone else's value.
# Running it again is safe: the file is the source of truth and the run re-applies it.

# --- Company (REQUIRED) --- must match what you entered in the ERPNext setup wizard
COMPANY_NAME=Example Firearms LLC
# Company abbreviation exactly as the wizard shows it (Desk > Company)
COMPANY_ABBR=EF
# The owner's login (the user the wizard created); also the store's contact e-mail
OWNER_EMAIL=owner@example.com

# --- Address (REQUIRED) --- printed on receipts and used as the store's home state
ADDRESS_LINE1=100 Main Street
CITY=Springfield
# Full state name or two-letter code, as ERPNext's State list knows it
STATE=Texas
PINCODE=78701
# Federal Firearms License number (printed in the receipt header)
FFL_NUMBER=9-99-999-99-9A-99999

# --- Sales tax (REQUIRED) ---
# Percent charged on taxable sales: 8.25 means 8.25%. Ask your accountant; do not guess.
SALES_TAX_RATE=8.25
# Names for the tax template and the item tax template that setup creates
SALES_TAX_TITLE=Texas Sales Tax 8.25%
ITT_TITLE=Taxable Goods

# --- Optional: contact and branding ---
STORE_PHONE=(555) 010-0000
STORE_WEBSITE=https://www.example.com
ADDRESS_LINE2=
# Defaults to United States
COUNTRY=United States
# California only: Certified Firearms Dealer number; blank leaves the line off the letter head
CFD_NUMBER=
# Image for receipts and the login page: a /files/... path already uploaded in Desk, or an https URL
LOGO_URL=
# Store policy printed under every receipt (plain text, one line per line); blank prints nothing
RECEIPT_FOOTER_NOTE=

# --- Optional: California excise tax ---
# California Firearm and Ammunition Excise Tax rate in percent (11 for California stores); 0 (the default) means none
CFET_RATE=0

# --- Optional: 4473 handling ---
# Blank (default): change nothing. A new site then needs FastBound set up before a firearm can be sold.
# paper:     the store keeps paper 4473s and runs background checks outside this system.
#            Turns FFL Settings > Paper 4473 Mode on and FastBound Settings > Enabled off.
# fastbound: the reverse (FastBound on, Paper 4473 Mode off). Enter the FastBound credentials in Desk afterwards.
# Paper mode moves where the 4473 is kept, not what the law requires. See docs/self-hosting.md.
FORM_4473_MODE=

# --- Optional: account and customer names (the defaults are fine) ---
BANK_ACCOUNT_NAME=Bank Account
CARD_CLEARING_ACCOUNT_NAME=Card Clearing
WALK_IN_CUSTOMER=Walk-in Customer
# Comma-separated Letter Head names left over from a template site that should be removed
FOREIGN_LETTER_HEADS=

# --- Optional: outgoing e-mail. Leave SMTP_* blank and e-mail stays off. ---
SMTP_SERVER=
SMTP_PORT=587
# SMTP login, and the password for it (a secret: this file must stay out of git)
SMTP_LOGIN=
SMTP_PASSWORD=
# Address mail is sent from; defaults to OWNER_EMAIL
SMTP_SENDER=
# Name of the Email Account record; defaults to COMPANY_NAME
SMTP_ACCOUNT_NAME=
